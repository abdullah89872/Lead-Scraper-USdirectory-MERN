SCRAPER_PORT=8000
SCRAPER_HOST=127.0.0.1

# mock   -> deterministic synthetic demo leads, never touches the network
# live   -> real requests to the directory source (robots.txt + ToS respected)
SCRAPER_MODE=mock

# httpx (fast, no browser download) | playwright (headless Chromium for JS pages)
SCRAPER_FETCHER=httpx
SCRAPER_HEADLESS=true
SCRAPER_USER_AGENT=LeadForgeAI/1.0 (+https://example.com/leadforge-bot; respectful crawler)

# Politeness / safety limits
SCRAPE_REQUEST_DELAY_MS=1200
SCRAPE_CONCURRENCY=2
SCRAPE_MAX_PAGES=20
SCRAPE_REQUEST_TIMEOUT_MS=20000
SCRAPE_MAX_RETRIES=2
SCRAPE_BLOCK_COOLDOWN_S=60
RESPECT_ROBOTS_TXT=true

# Website enrichment
ENRICHMENT_MAX_PAGES=5
ENRICHMENT_CONCURRENCY=2

# Optional override for the USdirectory search template.
# Supported placeholders: {category} {city} {state} {state_abbr} {page}
US_DIRECTORY_BASE_URL=https://usdirectory.com
US_DIRECTORY_SEARCH_TEMPLATE=

# Progress webhook (set by the Node API when it dispatches a job)
INTERNAL_API_TOKEN=change-me-internal-token
