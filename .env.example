# =====================================================================
# LeadForge AI - example environment file
# Copy to `.env` (root, used by docker-compose) and per-service files:
#   cp .env.example backend/.env
#   cp .env.example scraper/.env
# NEVER commit a real .env or real API keys.
# =====================================================================

# ---------------------------------------------------------------------
# Shared / mode
# ---------------------------------------------------------------------
NODE_ENV=development
# mock      -> no network calls to USdirectory.com, deterministic demo leads
# live      -> real requests to usdirectory.com (respect robots.txt + ToS)
SCRAPER_MODE=mock

# ---------------------------------------------------------------------
# Backend (Node/Express)
# ---------------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# MongoDB Atlas (backend only; never add these values to the frontend)
MONGODB_URI=
MONGODB_DB_NAME=leadforge
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=20

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379
# auto   -> use BullMQ when Redis is reachable, otherwise run jobs inline
# redis  -> force BullMQ (fails fast if Redis is down)
# inline -> never use Redis (single-process dev mode)
QUEUE_DRIVER=auto
WORKER_ENABLED=true

# Python scraper service
SCRAPER_URL=http://127.0.0.1:8000
SCRAPER_TIMEOUT_MS=180000
# Shared secret used by the scraper to post progress updates back to the API
INTERNAL_API_TOKEN=change-me-internal-token

# Scraping defaults (applied when the request does not override them)
SCRAPE_MAX_LEADS=100
SCRAPE_CONCURRENCY=2
SCRAPE_REQUEST_DELAY_MS=1200
SCRAPE_MAX_PAGES=20
SCRAPE_REQUEST_TIMEOUT_MS=20000
SCRAPE_MAX_RETRIES=2
ENRICHMENT_ENABLED=true
ENRICHMENT_MAX_PAGES=5
ENRICHMENT_CONCURRENCY=2
RESPECT_ROBOTS_TXT=true

# Logging
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Scraper (Python/FastAPI)
# ---------------------------------------------------------------------
SCRAPER_PORT=8000
# playwright -> headless Chromium (best for JS heavy pages)
# httpx      -> plain HTTP client (faster, no browser download needed)
SCRAPER_FETCHER=httpx
SCRAPER_USER_AGENT=LeadForgeAI/1.0 (+https://example.com/leadforge-bot; respectful crawler)
SCRAPER_HEADLESS=true

# ---------------------------------------------------------------------
# AI (optional - AI never invents contact information)
# ---------------------------------------------------------------------
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
AI_CACHE_TTL_DAYS=30

# ---------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api