# LeadForge AI - backend environment
# Copy to backend/.env and fill in real values. Never commit a real .env.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# MongoDB Atlas (required outside the isolated Jest test suite)
# Create a dedicated database user and narrowly allowlist the backend host IP.
# Never put this URI in frontend/.env or commit a populated .env file.
MONGODB_URI=
MONGODB_DB_NAME=leadforge
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=20

# Queue
# auto   -> BullMQ when Redis responds, otherwise run jobs inline
# redis  -> force BullMQ
# inline -> never touch Redis (single process dev mode / tests)
QUEUE_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379
WORKER_ENABLED=true
QUEUE_CONCURRENCY=2

# Scraper service
SCRAPER_MODE=mock
SCRAPER_URL=http://127.0.0.1:8000
SCRAPER_TIMEOUT_MS=300000
INTERNAL_API_TOKEN=change-me-internal-token

# Scrape defaults (the UI can override per job)
SCRAPE_MAX_LEADS=100
ENRICHMENT_ENABLED=true

# AI (optional; AI never invents contact information)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
AI_CACHE_TTL_DAYS=30

# Logging
LOG_LEVEL=info

# Email validation
# See backend/src/config/env.js (validation block) for all keys and defaults.
# Auto-validation runs fire-and-forget after a successful scrape; failures are
# logged, never fatal. SMTP probing is best-effort and disabled by default.
EMAIL_VALIDATION_AUTO=true
EMAIL_VALIDATION_BATCH_SIZE=200
EMAIL_VALIDATION_CONCURRENCY=10
EMAIL_MAX_EMAILS_PER_REQUEST=200
VALIDATION_MAX_ACTIVE_JOBS=3
VALIDATION_CACHE_TTL_DAYS=7

# DNS (MX) checks
DNS_TIMEOUT_MS=5000
DNS_CACHE_TTL_MS=3600000
DNS_NEGATIVE_CACHE_TTL_MS=60000

# SMTP probing (best-effort deliverability signal; enabled by default)
EMAIL_VALIDATION_VALID_POLICY=smtp
EMAIL_SMTP_ENABLED=true
EMAIL_SMTP_TIMEOUT_MS=10000
EMAIL_SMTP_MAX_CONCURRENCY=5
EMAIL_SMTP_RETRY_COUNT=1
EMAIL_SMTP_RETRY_BACKOFF_MS=500
EMAIL_SMTP_MIN_DELAY_MS=250
EMAIL_SMTP_ENVELOPE_FROM=probe@example.com
EMAIL_SMTP_PORT=25
EMAIL_SMTP_MAX_MX_TRIES=3

# CSV upload limits
CSV_UPLOAD_MAX_BYTES=5242880
CSV_UPLOAD_MAX_ROWS=50000
CSV_UPLOAD_MAX_COLUMNS=100
