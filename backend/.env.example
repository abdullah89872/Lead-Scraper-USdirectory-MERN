# LeadForge AI - backend environment
# Copy to backend/.env and fill in real values. Never commit a real .env.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Database
# mongo  -> connect to MONGO_URI (local install or docker-compose)
# memory -> ephemeral in-process MongoDB (dev/testing only; data is lost on exit)
DB_DRIVER=mongo
MONGO_URI=mongodb://127.0.0.1:27017/leadforge
ALLOW_MEMORY_DB=true

# Queue
# auto   -> BullMQ when Redis responds, otherwise run jobs inline
# redis  -> force BullMQ
# inline -> never touch Redis (single process dev mode / tests)
QUEUE_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379
WORKER_ENABLED=true
QUEUE_CONCURRENCY=2

# Scraper service
SCRAPER_MODE=mock
SCRAPER_URL=http://127.0.0.1:8000
SCRAPER_TIMEOUT_MS=300000
INTERNAL_API_TOKEN=change-me-internal-token

# Scrape defaults (the UI can override per job)
SCRAPE_MAX_LEADS=100
ENRICHMENT_ENABLED=true

# AI (optional; AI never invents contact information)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
AI_CACHE_TTL_DAYS=30

# Logging
LOG_LEVEL=info
